FROM docker.io/library/php:8.4-cli
RUN apt-get update && apt-get install -y --no-install-recommends libpng-dev libjpeg62-turbo-dev libwebp-dev unzip git curl jq \
 && docker-php-ext-configure gd --with-jpeg --with-webp && docker-php-ext-install gd && rm -rf /var/lib/apt/lists/*
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer
